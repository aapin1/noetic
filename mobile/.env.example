EXPO_PUBLIC_API_URL=http://localhost:3000

# Product analytics (PostHog). Both are publishable values, not secrets — the
# project API key is write-only by design. Leave them unset and the analytics
# layer is a no-op, which is what CI and throwaway dev clients want.
EXPO_PUBLIC_POSTHOG_KEY=
# us.i.posthog.com or eu.i.posthog.com, matching the region the project was
# created in. Defaults to US when unset.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crash reporting (Sentry). Also publishable — a DSN only permits writes.
# Unset means crash reporting is off.
EXPO_PUBLIC_SENTRY_DSN=

# Symbolication only. NOT an EXPO_PUBLIC_ var and never bundled into the app:
# it is read at build time by the Sentry Expo plugin to upload source maps, so
# it belongs in EAS build secrets, not in a shipped binary.
# SENTRY_AUTH_TOKEN=
